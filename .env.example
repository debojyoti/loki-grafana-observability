# Compose
COMPOSE_PROJECT_NAME=production-logging

# Public DNS names. Both records must point at the Droplet before deployment.
LOGS_DOMAIN=logs.example.com
GRAFANA_DOMAIN=grafana.example.com

# Grafana. Replace every change-me value before deployment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_SECRET_KEY=change-me-use-at-least-32-random-characters

# DigitalOcean Spaces (private Space; CDN disabled).
DO_SPACES_REGION=blr1
DO_SPACES_ENDPOINT=blr1.digitaloceanspaces.com
DO_SPACES_BUCKET=production-loki
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=

# Public log-ingestion Basic Auth credentials.
# deploy.sh generates the Caddy bcrypt hash from LOG_INGEST_PASSWORD.
# Keep the generated hash single-quoted because bcrypt hashes contain '$'.
LOG_INGEST_USERNAME=logger
LOG_INGEST_PASSWORD=change-me
LOG_INGEST_PASSWORD_HASH='replace-with-caddy-bcrypt-hash'

# Retention and ingress protection.
LOKI_RETENTION_PERIOD=720h
MAX_INGEST_BODY_SIZE=1MB

# Container memory ceilings; tune after observing real usage.
LOKI_MEMORY_LIMIT=896m
GRAFANA_MEMORY_LIMIT=384m
ALLOY_MEMORY_LIMIT=256m
CADDY_MEMORY_LIMIT=128m

